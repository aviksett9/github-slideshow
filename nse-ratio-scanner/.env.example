# Copy to .env and edit. Every value here is optional; the defaults are shown.

# Expiry to scan. "auto" picks the first monthly stock-option expiry at least MIN_DTE days away
# (today's expiry is never scanned). Or fix it, e.g. TARGET_EXPIRY=29-Dec-2026
TARGET_EXPIRY=auto
MIN_DTE=7

# Scheduler
SCAN_INTERVAL_MIN=15
MARKET_HOURS_ONLY=true
RUN_ON_START=true
# If set, POST /api/scan requires header X-Scan-Token with this value
SCAN_TOKEN=

# Ranking filters
CAP_MAX=500000
MIN_OI=50
MAX_SPR=0.10
MIN_DANGER_SIGMA=1.0

# A setup is "found" (alerted) only if it passes all of these
ALERT_DEFINED_ONLY=true
ALERT_MIN_SCORE=0.75
ALERT_MIN_PPROFIT=0.35
ALERT_MIN_EV=0
ALERT_MIN_ROI=0.15
ALERT_MAX_CAPITAL=300000
ALERT_TOP_N=5

# Optional: verify margin of shortlisted setups with Dhan's read-only margin calculator.
# Only /v2/margincalculator, /v2/margincalculator/multi and /v2/fundlimit are ever called; no order endpoint exists in the code.
# Dhan tokens expire (typically 24 h), so paste a fresh one here when it does. Keep this file private.
DHAN_ACCESS_TOKEN=
# Optional; read from /v2/fundlimit when empty
DHAN_CLIENT_ID=

# Optional notifications for new setups (sent once per setup per day)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WEBHOOK_URL=
